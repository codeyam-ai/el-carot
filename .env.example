# Copy to .env and fill in. `.env` is gitignored — never commit real values.

# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Production uses Neon; any Postgres works.
# Read by prisma.config.ts (Prisma CLI) and app/lib/prisma.ts (runtime).
# For a throwaway local database:
#   docker run -d --name el-carot-pg -e POSTGRES_PASSWORD=carot \
#     -e POSTGRES_DB=elcarot -p 5432:5432 postgres:16
#   DATABASE_URL=postgresql://postgres:carot@127.0.0.1:5432/elcarot
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Optional ───────────────────────────────────────────────────────────────
# Enables AI card interpretations (server-side only — never reaches the client).
# Without it the app falls back to each card's written meaning, which is a
# fully supported path, so local development does not need a key.
ANTHROPIC_API_KEY=

# Password gate for the /stats analytics page. Unset means /stats stays locked
# and tells you it is unconfigured.
STATS_PASSWORD=

# Shared secret authenticating the daily "card of the day" cron job.
CRON_SECRET=

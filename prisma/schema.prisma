// Prisma 7 on PostgreSQL (Neon) via the @prisma/adapter-pg driver adapter.
//
// IMPORTANT: Use "prisma-client-js" (NOT "prisma-client").
// The "prisma-client" generator requires a custom output path which
// breaks Turbopack import resolution and seed script imports.
// "prisma-client-js" outputs to node_modules/@prisma/client which
// works everywhere with standard imports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// El Carot — login-free comments left under a reading.
// Production starts empty; scenarios carry seed rows.
// ──────────────────────────────────────────────
model Comment {
  id        String   @id @default(cuid())
  name      String
  text      String
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────
// Analytics / logging (see lib/geo.ts for the coarse Vercel geo fields).
// ──────────────────────────────────────────────

/// The card of the day — one row per UTC calendar day, chosen once and shared by
/// everyone who draws that day.
model DailyCard {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD (UTC)
  cardN     Int
  createdAt DateTime @default(now())
}

/// Every question asked in the AI flow, with the drawn card and coarse geo.
model Question {
  id        String   @id @default(cuid())
  text      String
  cardN     Int
  lang      String
  source    String // 'ai' | 'fallback'
  country   String?
  region    String?
  timezone  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A visit to the site — logged once per session, with coarse geo + time.
model Visit {
  id        String   @id @default(cuid())
  path      String
  country   String?
  region    String?
  timezone  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

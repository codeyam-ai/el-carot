ted-components/StarDivider/page.tsx","status":"added"},{"path":"app/isolated-components/TarotCard/page.tsx","status":"added"},{"path":"app/layout.tsx","status":"modified"},{"path":"app/question/page.tsx","status":"added"},{"path":"app/reading/page.tsx","status":"modified"},{"path":"components/AboutScreen.tsx","status":"modified"},{"path":"components/CardFan.tsx","status":"modified"},{"path":"components/CardReading.tsx","status":"modified"},{"path":"components/CarotMenu.tsx","status":"modified"},{"path":"components/Comments.tsx","status":"modified"},{"path":"components/DeckArc.tsx","status":"added"},{"path":"components/DesktopNav.tsx","status":"added"},{"path":"components/GalleryGrid.tsx","status":"modified"},{"path":"components/MenuToggle.tsx","status":"modified"},{"path":"components/MessageIntro.tsx","status":"modified"},{"path":"components/QuestionInput.tsx","status":"added"},{"path":"lib/interpret-prompts.test.ts","status":"added"},{"path":"lib/interpret-prompts.ts","status":"added"},{"path":"lib/useIsDesktop.ts","status":"added"},{"path":"package-lock.json","status":"modified"},{"path":"package.json","status":"modified"}],"narrative":null,"orphanedFiles":[],"projectWideCoverage":null,"step":17,"stepLabel":"App Scenarios","suiteTrendDeltaSecs":0,"testRunnerStats":{"duration_ms":null,"failed":0,"ignored":0,"passed":18,"per_runner":[{"duration_ms":null,"failed":0,"ignored":0,"name":"tests","passed":18,"total":18}],"runners":["tests"],"total":18},"userPrompt":"# El Carot — Plan: Flujo de pregunta con IA (/question)\n\nConstruir el flujo \"Tengo una pregunta específica\" (el 2º botón de la Home), con\ninterpretación por IA y **fallback elegante** (funciona sin API key todavía).\n\n## Pantalla QuestionInput (/question)\n- Header con flecha de volver + título \"Tengo una pregunta específica\".\n- Heading \"Dejá tu pregunta\" + subtítulo sobre cuánto más específica, mejor.\n- Textarea full-height (placeholder \"Dejá tu pregunta aquí\").\n- Botón \"Sacar una carta\" (deshabilitado/atenuado hasta que escribas algo).\n- Al enviar → elige una carta al azar → navega a\n  `/reading?n=<n>&origin=question&q=<pregunta>`.\n\n## Lectura con pregunta (ya existe /reading, se le agrega el modo IA)\n- Carta que se da vuelta, divisor de 3 estrellas salvia.\n- Label \"TU PREGUNTA\" + la pregunta en cursiva.\n- Mientras la IA piensa: \"Interpretando tu carta…\" (como el diseño).\n- Cuando resuelve: la interpretación generada reemplaza el loading.\n\n## Backend: endpoint de interpretación (/api/interpret)\n- POST `{ cardN, question, lang }` → llama a Claude server-side con los prompts\n  del handoff (voseo ES / EN), tono El Carot, 3-5 oraciones, un párrafo.\n- Usa el **modelo más barato** (Claude Haiku 3) para minimizar tokens.\n- Lee `ANTHROPIC_API_KEY` del entorno. **Fallback:** si no hay key o falla la\n  llamada, devuelve el significado base de la carta. La key nunca se expone al\n  cliente.\n\n## Estados / escenarios\n- QuestionInput — vacío (botón deshabilitado).\n- QuestionInput — con texto (botón habilitado).\n- Lectura con pregunta — interpretando (loading).\n- Lectura con pregunta — interpretación mostrada (por ahora el significado base,\n  hasta cargar la key).\n\n## Notas\n- Sin base de datos nueva (producción sigue vacía).\n- Modo UI (página + variante de lectura + API route con impacto en UI).\n- Cuando se cargue `ANTHROPIC_API_KEY` en `.env.local`, la IA real se activa sin\n  cambios de código.\n"}